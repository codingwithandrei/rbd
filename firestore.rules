rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    // Helper function to check if user has specific role
    function hasRole(role) {
      return isAuthenticated() && (getUserRole() == role || isAdmin());
    }
    
    // Users collection - only authenticated users can read their own data
    // Users can create their own document on first login, admins can write to any
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId; // Users can create their own document
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin()); // Users can update their own, admins can update any
      allow delete: if isAdmin();
    }
    
    // QR Codes collection
    // Allow unauthenticated reads (for QR scanning without login)
    // Users can only see what they query for
    match /qrCodes/{qrCodeId} {
      allow read: if true; // Allow reads for QR scanning
      
      // Only authenticated users can write
      allow create: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow delete: if isAdmin();
    }
    
    // Master Rolls collection
    // Allow unauthenticated reads (for viewing master roll info when scanning QR)
    match /masterRolls/{rollId} {
      allow read: if true; // Allow reads for QR scanning
      
      // Only authenticated users can write
      allow create: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow delete: if isAdmin();

      // The offcut reviewer has no account: their email link's code lets them answer once.
      // The code is only saved here after answering, and an answered review can't change.
      allow update: if resource.data.reviewStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus', 'reviewedAt', 'reviewToken', 'status', 'stockNumber'])
        && ((request.resource.data.reviewStatus == 'approved' && request.resource.data.status == resource.data.status)
          || (request.resource.data.reviewStatus == 'discarded' && request.resource.data.status == 'discarded'))
        && getAfter(/databases/$(database)/documents/offcutReviews/$(request.resource.data.reviewToken)).data.masterRollId == rollId
        && getAfter(/databases/$(database)/documents/offcutReviews/$(request.resource.data.reviewToken)).data.status == request.resource.data.reviewStatus
        && getAfter(/databases/$(database)/documents/offcutReviews/$(request.resource.data.reviewToken)).data.stockNumber == request.resource.data.stockNumber;
    }

    // Child Rolls collection
    // Allow unauthenticated reads (for viewing child rolls when scanning QR)
    match /childRolls/{childRollId} {
      allow read: if true; // Allow reads for QR scanning
      
      // Only authenticated users can write
      allow create: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow delete: if isAdmin();
    }
    
    // Scan Events collection
    // Allow unauthenticated reads and creates (for tracking scans)
    match /scanEvents/{eventId} {
      allow read: if true; // Allow reads for viewing scan history
      allow create: if true; // Anyone can create scan events (for tracking)
      
      // Only authenticated users can update/delete
      allow update: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow delete: if isAdmin();
    }
    
    // Roll Labels collection - blank QR labels linked to child rolls at the slitter
    // Anyone can open one label by its (unguessable) code; only signed-in users can list them
    match /rollLabels/{labelCode} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow delete: if isAdmin();
    }

    // Slitting Runs collection - one record per run (job, lanes, widths, length cut)
    match /slitRuns/{runId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow delete: if isAdmin();
    }

    // Counters (next roll label number, next offcut stock count per width)
    match /counters/{counterId} {
      allow read: if isAuthenticated() || counterId.matches('offcut-[0-9]+');
      allow write: if isAuthenticated() && (isAdmin() || hasRole('operator'));

      // The offcut reviewer can move an offcut count forward only, in the same save as answering their review
      allow create, update: if counterId.matches('offcut-[0-9]+')
        && request.resource.data.keys().hasOnly(['next', 'lastReviewToken'])
        && request.resource.data.next is int
        && (resource == null || request.resource.data.next > resource.data.next)
        && get(/databases/$(database)/documents/offcutReviews/$(request.resource.data.lastReviewToken)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/offcutReviews/$(request.resource.data.lastReviewToken)).data.status == 'approved'
        && counterId == 'offcut-' + string(get(/databases/$(database)/documents/offcutReviews/$(request.resource.data.lastReviewToken)).data.widthMm);
    }

    // Offcut Reviews - the document ID is the secret code in the reviewer's email links.
    // Anyone with the code can open it and answer once; only workers can list them.
    match /offcutReviews/{reviewToken} {
      allow get: if true;
      allow list: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow create: if isAuthenticated() && (isAdmin() || hasRole('operator'));
      allow update: if resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'stockNumber'])
        && request.resource.data.status in ['approved', 'discarded']
        && request.resource.data.stockNumber is string
        && request.resource.data.stockNumber.matches('^[A-Za-z0-9-]{1,40}$')
        && getAfter(/databases/$(database)/documents/masterRolls/$(resource.data.masterRollId)).data.reviewStatus == request.resource.data.status;
      allow delete: if false;
    }

    // Deleted Stock Numbers collection
    // Only authenticated users can access
    match /deletedStockNumbers/{deletedId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
